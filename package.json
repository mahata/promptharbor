{
  "name": "prompt-harbor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:companion": "pnpm companion:build && vitest run --config vitest.companion.config.ts",
    "test:e2e": "pnpm build && playwright test",
    "check": "pnpm test && pnpm test:companion && pnpm test:e2e",
    "companion:build": "node src/companion/build-cli.ts",
    "companion:package": "pnpm companion:build && node src/companion/package-cli.ts",
    "companion:install": "pnpm companion:build && node src/companion/install-cli.ts",
    "companion:uninstall": "node src/companion/install-cli.ts --uninstall"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.4",
    "rolldown": "^1.2.12",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@github/copilot-sdk": "^1.0.16",
    "marked": "^18.0.14"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "koffi"
    ]
  }
}
